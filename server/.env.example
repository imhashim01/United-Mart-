# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_VERSION=v1

# MongoDB
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/unitedMartSukkur?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=replace_with_strong_random_secret
JWT_REFRESH_SECRET=replace_with_different_strong_random_secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Nodemailer - order confirmations)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Orders / Checkout
TAX_RATE=0
SHIPPING_FEE=200
FREE_SHIPPING_THRESHOLD=5000

# Set to a truthy value only if MONGO_URI points to a replica set / Atlas cluster
# (required for multi-document ACID transactions during checkout)
MONGO_REPLICA_SET=

# Default admin account — created by `npm run seed` if it doesn't already exist.
# Change these before running seed in any shared/production environment.
DEFAULT_ADMIN_NAME=United Mart Admin
DEFAULT_ADMIN_EMAIL=admin@unitedmartsukkur.pk
DEFAULT_ADMIN_PASSWORD=Admin@12345


