{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.unitedmartsukkur.com" }],
      "destination": "https://unitedmartsukkur.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}